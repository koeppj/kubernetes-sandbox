# Copy to .env (ignored). No VIP is assumed or reserved by these scripts.
# Only the master2-only migration phase is supported. No automatic failover.
NFS_HA_PHASE=migration
NFS_HA_VIP=
NFS_HA_PREFIX=24
NFS_HA_INTERFACE=enp2s0
# Keep identical on both nodes; use the reserved VIP as recommended by the agent.
NFS_HA_SCOPE=
NFS_HA_CLIENTS='192.168.1.0/24 10.0.0.0/24'
NFS_HA_FSID_KUBE=102
NFS_HA_FSID_GRAFANA=103
NFS_HA_FSID_POSTGRES=104
# Must exceed the measured NFSv4 lease time with margin.
NFS_HA_EXPORT_STOP_TIMEOUT=180
