# Copy to .env and replace every placeholder. Keep single quotes around bcrypt
# hashes so Bash preserves the dollar signs. Do not use Docker Compose $$ escaping.
# Generate a password hash interactively:
# docker run --rm -it binwiederhier/ntfy:v2.36.0 user hash
NTFY_AUTH_USERS='ntfy:<bcrypt-password-hash>:user'
# A single account may publish and subscribe to every topic; anonymous access is denied.
NTFY_AUTH_ACCESS='ntfy:*:rw'
# Generate the suffix with: LC_ALL=C tr -dc a-z0-9 </dev/urandom | head -c 29
NTFY_AUTH_TOKENS='ntfy:tk_<29-lowercase-alphanumeric-characters>:Shared token'
