@startuml box
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Box Namespace - Current C4 Container View

Person(user, "User", "Calls the redaction or localapp endpoint.")
Person(operator, "Operator", "Applies Box redaction and proxy manifests.")

System_Boundary(cluster, "MicroK8s Cluster") {
  Container_Boundary(ns, "namespace: box") {
    Container(routeHttps, "box-redaction-route", "HTTPRoute", "HTTPS route for boxredact.johnkoepp.com.")
    Container(routeRedirect, "box-redaction-redirect", "HTTPRoute", "HTTP to HTTPS redirect and Route53 labels.")
    Container(redaction, "box-redaction", "Deployment: ECR boxredact:latest", "Running redaction service.")
    Container(localappRoute, "localapp-route", "HTTPRoute", "Public route for localapp.johnkoepp.com.")
    Container(localappProxy, "box-localapp-proxy", "Service + Endpoints", "Proxy to an external local app.")
  }
  Container(publicGateway, "johnkoepp-com-gateway", "Gateway", "Public shared gateway.")
}

System_Ext(route53, "AWS Route53", "Public DNS records.")
System_Ext(localapp, "External local app", "Endpoint outside this Kubernetes namespace.")

Rel(user, routeHttps, "connects to", "HTTPS")
Rel(user, localappRoute, "connects to", "HTTPS")
Rel(routeHttps, publicGateway, "attaches to")
Rel(routeRedirect, publicGateway, "attaches to")
Rel(localappRoute, publicGateway, "attaches to")
Rel(routeRedirect, route53, "is discovered by labels for")
Rel(routeHttps, redaction, "forwards to", "Service box-redaction-service:80")
Rel(localappRoute, localappProxy, "forwards to")
Rel(localappProxy, localapp, "proxies to")
Rel(operator, redaction, "deploys with deploy-redact.sh")

@enduml
